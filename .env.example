# Copy to .env.local and restart the dev server.

# Required — inbox for contact form messages
CONTACT_RECEIVER_EMAIL=your-email@example.com

# Email is sent via FormSubmit from the browser when only CONTACT_RECEIVER_EMAIL is set.
# On first use, FormSubmit sends an activation link to that inbox — click it to enable delivery.

# Optional SMTP (Gmail, Outlook, etc.) — server-side delivery when configured
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Fahreza Portfolio <your-email@example.com>"

# Optional Web3Forms key from https://web3forms.com
# WEB3FORMS_ACCESS_KEY=
